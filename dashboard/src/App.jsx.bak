import { useState } from "react"
import Plot from "react-plotly.js"

const API_BASE = "http://localhost:8000/api/v1/causal-cut"

const ZONES = [
  { id: "zone-1", label: "Zone 1 — Coke Oven" },
  { id: "zone-2", label: "Zone 2 — Blast Furnace" },
  { id: "zone-3", label: "Zone 3 — Machine Shop" },
  { id: "zone-4", label: "Zone 4 — Shared Utilities" },
  { id: "zone-5", label: "Zone 5 — CCTV / PPE Checkpoints" },
  { id: "zone-6", label: "Zone 6 — Control Room" },
]

// Coke-oven scenario preset (design doc §8). This is [S] synthetic input
// until it is read from the real event store / hypergraph.
const SCENARIO = {
  zone_risk: { "zone-1": 0.55 },
  hazard_severity: { "zone-1": 0.8 },
  active_paths: ["HE-042"],
  watch_zone: "zone-1",
  candidates: [
    { id: "suspend_permit", action: "Suspend hot-work permit", cost: 0.1, latency_s: 10, covers_paths: ["HE-042"] },
    { id: "close_barrier", action: "Close zone-1/zone-4 ventilation barrier", cost: 0.15, latency_s: 30, covers_paths: ["HE-042"] },
    { id: "evacuate", action: "Evacuate zone-1 workers", cost: 0.6, latency_s: 120, covers_paths: ["HE-042"] },
  ],
}

function riskColor(risk) {
  if (risk >= 0.75) return "bg-red-600"
  if (risk >= 0.4) return "bg-orange-500"
  if (risk >= 0.15) return "bg-yellow-400"
  return "bg-green-600"
}

export default function App() {
  const [zoneRisk, setZoneRisk] = useState({})
  const [recommendation, setRecommendation] = useState(null)
  const [trajectory, setTrajectory] = useState(null)
  const [approvalStatus, setApprovalStatus] = useState(null) // null | "approved" | "rejected"
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState(null)

  async function runScenario() {
    setLoading(true)
    setError(null)
    setApprovalStatus(null)
    try {
      const recommendRes = await fetch(`${API_BASE}/recommend`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(SCENARIO),
      })
      if (!recommendRes.ok) throw new Error(`recommend failed: ${recommendRes.status}`)
      const recommendData = await recommendRes.json()
      setRecommendation(recommendData)

      const simulateRes = await fetch(`${API_BASE}/simulate`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          zone_risk: SCENARIO.zone_risk,
          hazard_severity: SCENARIO.hazard_severity,
          horizon_seconds: 300,
          dt_seconds: 10,
          close_barrier_edge: ["zone-1", "zone-4"],
          close_barrier_at_s: 30,
          close_barrier_magnitude: 0.05,
        }),
      })
      if (!simulateRes.ok) throw new Error(`simulate failed: ${simulateRes.status}`)
      const simulateData = await simulateRes.json()
      setTrajectory(simulateData)

      setZoneRisk({ ...SCENARIO.zone_risk, "zone-4": simulateData.baseline["zone-4"]?.at(-1) ?? 0 })
    } catch (err) {
      setError(err.message)
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="min-h-screen bg-neutral-950 text-neutral-100 p-8">
      <div className="max-w-6xl mx-auto space-y-8">

        <header>
          <h1 className="text-2xl font-semibold tracking-tight">CAUSALCUT — Operator Console</h1>
          <p className="text-neutral-400 text-sm mt-1">Steelforge Industries · Minimum-Causal-Cut Safety Twin</p>
        </header>

        <button
          onClick={runScenario}
          disabled={loading}
          className="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 disabled:opacity-50 font-medium transition"
        >
          {loading ? "Running coke-oven scenario…" : "Run Coke-Oven Scenario (HE-042)"}
        </button>

        {error && (
          <div className="rounded-lg border border-red-700 bg-red-950 text-red-300 px-4 py-3 text-sm">
            {error} — is the backend running on localhost:8000? (uvicorn app.main:app --reload)
          </div>
        )}

        {/* Zone map */}
        <section>
          <h2 className="text-sm font-medium text-neutral-400 uppercase tracking-wide mb-3">Factory Zone Map</h2>
          <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
            {ZONES.map((zone) => {
              const risk = zoneRisk[zone.id] ?? 0
              return (
                <div key={zone.id} className="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
                  <div className="flex items-center justify-between">
                    <span className="text-sm font-medium">{zone.label}</span>
                    <span className={`w-3 h-3 rounded-full ${riskColor(risk)}`} />
                  </div>
                  <div className="mt-2 text-2xl font-semibold tabular-nums">{risk.toFixed(2)}</div>
                  <div className="text-xs text-neutral-500">current risk [P]</div>
                </div>
              )
            })}
          </div>
        </section>

        {/* Time-to-harm + risk timeline */}
        {recommendation && (
          <section className="rounded-xl border border-neutral-800 bg-neutral-900 p-5">
            <h2 className="text-sm font-medium text-neutral-400 uppercase tracking-wide mb-2">Time-to-Harm</h2>
            <div className="text-3xl font-semibold">
              {recommendation.time_to_harm_seconds !== null
                ? `${Math.round(recommendation.time_to_harm_seconds)}s`
                : "Not on a harm trajectory"}
            </div>
            <p className="text-xs text-neutral-500 mt-1">[P] forecast, current conditions held constant</p>
          </section>
        )}

        {trajectory && (
          <section className="rounded-xl border border-neutral-800 bg-neutral-900 p-5">
            <h2 className="text-sm font-medium text-neutral-400 uppercase tracking-wide mb-3">
              Zone-4 Risk — Baseline vs. Intervention
            </h2>
            <Plot
              data={[
                {
                  x: trajectory.timestamps_s,
                  y: trajectory.baseline["zone-4"],
                  type: "scatter",
                  mode: "lines",
                  name: "Do nothing [C]",
                  line: { color: "#ef4444", dash: "dot" },
                },
                ...(trajectory.treated
                  ? [{
                      x: trajectory.timestamps_s,
                      y: trajectory.treated["zone-4"],
                      type: "scatter",
                      mode: "lines",
                      name: "Close barrier @30s [C]",
                      line: { color: "#22c55e" },
                    }]
                  : []),
              ]}
              layout={{
                paper_bgcolor: "transparent",
                plot_bgcolor: "transparent",
                font: { color: "#e5e5e5" },
                margin: { t: 10, r: 10, l: 40, b: 40 },
                height: 320,
                xaxis: { title: "seconds" },
                yaxis: { title: "risk", range: [0, 1] },
                legend: { orientation: "h", y: -0.2 },
              }}
              config={{ displayModeBar: false }}
              style={{ width: "100%" }}
            />
          </section>
        )}

        {/* Minimum-causal-cut approval panel */}
        {recommendation && (
          <section className="rounded-xl border border-neutral-800 bg-neutral-900 p-5">
            <h2 className="text-sm font-medium text-neutral-400 uppercase tracking-wide mb-3">
              Minimum-Causal-Cut Recommendation
            </h2>

            <div className="text-xs text-neutral-500 mb-3">
              status: {recommendation.status} · path HE-042
              {recommendation.uncovered_paths.length > 0 && (
                <span className="text-red-400"> · uncovered: {recommendation.uncovered_paths.join(", ")}</span>
              )}
            </div>

            <ul className="space-y-2 mb-4">
              {recommendation.recommended_action_ids.map((id) => {
                const c = SCENARIO.candidates.find((cand) => cand.id === id)
                return (
                  <li key={id} className="flex items-center justify-between rounded-lg bg-neutral-800 px-3 py-2 text-sm">
                    <span>{c?.action ?? id}</span>
                    <span className="text-neutral-400 text-xs">cost {c?.cost} · {c?.latency_s}s</span>
                  </li>
                )
              })}
            </ul>

            <p className="text-xs text-neutral-500 mb-3">{recommendation.note}</p>

            {approvalStatus === null ? (
              <div className="flex gap-2">
                <button
                  onClick={() => setApprovalStatus("approved")}
                  className="px-4 py-2 rounded-lg bg-green-600 hover:bg-green-700 text-sm font-medium"
                >
                  [H] Approve
                </button>
                <button
                  onClick={() => setApprovalStatus("rejected")}
                  className="px-4 py-2 rounded-lg bg-neutral-700 hover:bg-neutral-600 text-sm font-medium"
                >
                  [H] Reject
                </button>
              </div>
            ) : (
              <div className={`text-sm font-medium ${approvalStatus === "approved" ? "text-green-400" : "text-neutral-400"}`}>
                {approvalStatus === "approved" ? "Approved — awaiting backend execution endpoint" : "Rejected"}
              </div>
            )}
          </section>
        )}

      </div>
    </div>
  )
}

