# CAUSALCUT configuration. Copy to .env; all values are optional.
# Env prefix: CAUSALCUT_

# --- Identity / HTTP ---
CAUSALCUT_APP_NAME=CAUSALCUT
CAUSALCUT_ENVIRONMENT=dev
CAUSALCUT_FACTORY_ID=steelforge-001
CAUSALCUT_HOST=0.0.0.0
CAUSALCUT_PORT=8000
CAUSALCUT_API_V1_PREFIX=/api/v1
CAUSALCUT_MAX_REQUEST_BYTES=2097152
CAUSALCUT_REQUEST_TIMEOUT_SECONDS=10.0

# --- Persistence (WAL SQLite) ---
CAUSALCUT_DB_PATH=./data/causalcut.db
CAUSALCUT_SQLITE_BUSY_TIMEOUT_MS=5000
CAUSALCUT_SQLITE_SYNCHRONOUS=NORMAL

# --- Queue ---
CAUSALCUT_QUEUE_MAX_SIZE=10000
CAUSALCUT_QUEUE_CONSUMER_COUNT=2
CAUSALCUT_QUEUE_PUT_TIMEOUT_SECONDS=0.5
CAUSALCUT_DEAD_LETTER_MAX_RETRIES=3

# --- Risk engine + approval gateway (analytical half) ---
CAUSALCUT_SAFETY_THRESHOLD=0.15
CAUSALCUT_AUDIT_BASE_PATH=./data/audit
CAUSALCUT_HANDOVER_ACK_GRACE_MIN=15

# --- Logging ---
CAUSALCUT_LOG_LEVEL=INFO
CAUSALCUT_LOG_JSON=true

# --- Security ---
# Ingest write-guard (optional). If set, /events/ingest requires this X-API-Key.
# CAUSALCUT_API_KEY=change-me
# PRODUCTION: real operators for the approval gateway; removes built-in dev keys.
# Format: id:role:key,...  Roles: viewer|operator|shift_officer|safety_manager
# CAUSALCUT_OPERATORS=SO-A:shift_officer:REPLACE,SM-01:safety_manager:REPLACE
CAUSALCUT_DOCS_ENABLED=true

# --- CORS (frontend origins allowed to call the API) ---
# Comma-separated. Vite dev server defaults to :4000.
CAUSALCUT_CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173

# --- Frontend (dashboard/.env — Vite reads VITE_* at build/dev time) ---
# VITE_API_BASE=http://localhost:8000/api/v1
# VITE_OPERATOR_KEY=dev-key-so-a

# --- Ingestion policy ---
CAUSALCUT_INGEST_BATCH_MAX=500
CAUSALCUT_DEFAULT_VALIDITY_WINDOW_SECONDS=300
CAUSALCUT_STALE_EVENT_GRACE_SECONDS=60
CAUSALCUT_FUTURE_EVENT_TOLERANCE_SECONDS=30

# --- Model inference layer ---
CAUSALCUT_MODEL_EXECUTION_MODE=auto      # auto | real | degraded | mock (tests only)
CAUSALCUT_MODEL_DEVICE=cpu               # cpu | cuda
CAUSALCUT_MODEL_CONFIDENCE_THRESHOLD=0.5
CAUSALCUT_MODEL_REQUEST_TIMEOUT_S=10.0
CAUSALCUT_MODEL_RETRY_COUNT=1
CAUSALCUT_MODEL_RETRY_BACKOFF_S=0.25

# Artifact path overrides (defaults resolve under the repo root)
# CAUSALCUT_GAS_XGB_MODEL_PATH=./.models/XGB Classifier/model_1&2.joblib
# CAUSALCUT_GAS_ISOFOREST_MODEL_PATH=./.models/Isolation Forest Anomaly Detector/gas_sensor_isoforest_pipeline.joblib
# CAUSALCUT_HYDRAULIC_MODEL_DIR=./.models/Hydraulic Classifier
CAUSALCUT_MACHINE_MODEL_DIR=./.models/AI4I Classifier
# CAUSALCUT_VISION_MODEL_PATH=./models/yolov8_ppe.pt

# Remote model service URLs (only if models run as separate services)
# CAUSALCUT_GAS_MODEL_API_URL=http://localhost:9000/api/v1/models/gas/predict
# CAUSALCUT_MACHINE_MODEL_API_URL=http://localhost:9000/api/v1/models/machine-failure/predict
# CAUSALCUT_HYDRAULIC_MODEL_API_URL=http://localhost:9000/api/v1/models/hydraulic/predict
# CAUSALCUT_VISION_MODEL_API_URL=http://localhost:9000/api/v1/models/vision/detect
# CAUSALCUT_TRACKING_MODEL_API_URL=http://localhost:9000/api/v1/models/tracking/update
# CAUSALCUT_RAG_MODEL_API_URL=http://localhost:9000/api/v1/models/regulatory/verify

# --- Scenario pipeline ---
# How long /scenario/run waits for its events to traverse the queue and be
# projected into SQLite before analysis begins (HTTP 504 on timeout).
CAUSALCUT_SCENARIO_PIPELINE_TIMEOUT_S=30.0

# --- Regulatory RAG resources ---
# CAUSALCUT_RAG_INDEX_PATH=./regulatory_rag/faiss_store/regulatory.index
# CAUSALCUT_RAG_METADATA_PATH=./regulatory_rag/faiss_store/regulatory_metadata.json
# CAUSALCUT_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Frontend ---
# VITE_API_BASE=http://localhost:8000/api/v1
# VITE_WS_BASE=ws://localhost:8000

# --- Vision / tracking artifacts (optional) ---
# If the YOLO checkpoint is absent, vision + tracking report unavailable and
# never fabricate detections.
# CAUSALCUT_VISION_MODEL_PATH=./models/yolov8_ppe.pt
